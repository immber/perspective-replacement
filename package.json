{
  "name": "perspective-replacement",
  "version": "0.0.0",
  "main": "dist/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "fetch-model": "tsx scripts/fetch-model.ts"
  },
  "private": "true",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.22.0",
    "fastify": "^5.12.7"
  }
}
